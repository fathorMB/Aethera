{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aethera",
  "version": "0.1.0",
  "identifier": "dev.aethera.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5283",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aethera",
        "width": 1360,
        "height": 880,
        "minWidth": 1180,
        "minHeight": 640,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#141619"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:5283 http://127.0.0.1:5283"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Launcher per llama-server"
  }
}
